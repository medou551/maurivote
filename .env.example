# ══════════════════════════════════════════════════════════════════════════════
# MauriVote — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS committer .env dans Git !
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Twilio (SMS OTP +222 Mauritanie) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+222XXXXXXXX

# ── Chiffrement du vote (AES-256) ─────────────────────────────────────────────
# CRITIQUE : Ne jamais changer cette valeur en production !
# Générer avec : openssl rand -base64 32
VOTE_ENCRYPTION_SEL=GENERER_AVEC_openssl_rand_base64_32

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=maurivote-prod

# ── Environnement ─────────────────────────────────────────────────────────────
APP_ENV=development   # development | staging | production

# ── Tests de charge k6 ───────────────────────────────────────────────────────
TEST_ELECTION_ID=uuid-election-de-test
TEST_CANDIDATE_ID=uuid-candidat-de-test
